.lake/
build/
__pycache__/
state/

# Acquired third-party PDFs, scans, and source archives are retained as
# working-tree evidence only.  Their artifact-level disposition ledger and
# source-closure records are public; the binaries require verified permission
# before they can enter the public candidate.
docs/primary-sources/**/*.pdf
docs/primary-sources/**/*.scan
docs/primary-sources/**/*.tar
docs/primary-sources/**/*.tar.gz
docs/primary-sources/**/*.tar.bz2
docs/primary-sources/**/*.tar.xz
docs/primary-sources/**/*.tbz
docs/primary-sources/**/*.tbz2
docs/primary-sources/**/*.txz
docs/primary-sources/**/*.tgz
docs/primary-sources/**/*.zip
docs/primary-sources/**/*.rar
docs/primary-sources/**/*.7z
docs/primary-sources/**/*.gz
docs/primary-sources/**/*.bz2
docs/primary-sources/**/*.xz
docs/primary-sources/**/*.zst

# Transient probe file written by scripts/residual_evaluator.py, one probe at a
# time. It is the question put to the kernel on the last iteration, not a
# source file, and the run overwrites it.
_residual_probe.lean

# LaTeX build byproducts. Running `make` (or `pdflatex`/`tectonic` directly)
# against paper/*.tex produces these alongside the tracked .pdf; they are the
# exact set paper/Makefile's own `clean` target removes. No .aux/.log/.out/.toc
# file is ever intentionally committed, so this is safe repo-wide.
*.aux
*.log
*.out
*.toc

# Legacy checkout-local state for scripts/validation_singleflight.py. New cold
# clones use a repository-scoped host cache so equivalent checkouts can share;
# either location is disposable acceleration, never evidence.
.validation-singleflight/

# Conventional scratch/output directory. Nothing under a top-level tmp/ is
# ever tracked.
/tmp/
