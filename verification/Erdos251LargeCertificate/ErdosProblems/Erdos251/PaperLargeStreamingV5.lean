import ErdosProblems.Erdos251.StreamingChunksV5.Chunk0250

/-! Large endpoint via restartable kernel candidates. UNRUN.
The old monolithic PaperLargeCertificateR7 module is NOT imported.
All primes/count/prefix conditions are replayed by the block chain.
The stronger exponent is a separate V5 result, not a restatement of 39997. -/
namespace ErdosProblems.Erdos251.PaperV5.LargeStreaming
open ErdosProblems.Erdos251.PaperV5.Streaming
set_option maxRecDepth 200000
set_option maxHeartbeats 0
set_option exponentiation.threshold 200000

def c : ℕ := 80200
def X : ℕ := 1023068
def A : ℕ := Chunks.state0250.2
def u : ℕ := 
def v : ℕ := 
def up : ℕ := 
def vp : ℕ := 

theorem endpoint : prefix X = (c, A) := by
  exact Chunks.endpoint0250

theorem arithmetic : 0 < v ∧ 0 < vp ∧ up * v = u * vp + 1 ∧
    u * 2 ^ c < A * v ∧
    (2 * A + 5000 * (c + 1) ^ 4) * vp < up * 2 ^ (c + 1) := by
  refine ⟨?hv, ?hvp, ?hdet, ?hlo, ?hhi⟩
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem bit_floor : (2 ^ 40062 : ℕ) ≤ v + vp := by decide +kernel

/-- `10^12059 < 2^40062` from two small kernel inequalities, not from
constructing the full powers. -/
theorem decimal_floor : (10 ^ 12059 : ℕ) < 2 ^ 40062 := by
  have h59 : (10 ^ 59 : ℕ) < 2 ^ 196 := by decide +kernel
  have h23 : (10 ^ 23 : ℕ) < 2 ^ 78 := by decide +kernel
  have hpow : (10 ^ 12036 : ℕ) < 2 ^ 39984 := by
    have h := Nat.pow_lt_pow_left h59 (by decide : (204 : ℕ) ≠ 0)
    have h' : (10 ^ (59 * 204) : ℕ) < 2 ^ (196 * 204) := by
      simpa [Nat.pow_mul] using h
    exact h'
  have hleft : (10 ^ 12059 : ℕ) < 2 ^ 39984 * 10 ^ 23 := by
    have hshape : (10 ^ 12059 : ℕ) = 10 ^ 12036 * 10 ^ 23 := by
      simpa using (Nat.pow_add (10 : ℕ) 12036 23).symm
    rw [hshape]
    exact Nat.mul_lt_mul_of_pos_right hpow (Nat.pow_pos (by decide : 0 < 10))
  have hmid : 2 ^ 39984 * 10 ^ 23 < 2 ^ 39984 * 2 ^ 78 :=
    Nat.mul_lt_mul_of_pos_left h23 (Nat.pow_pos (by decide : 0 < 2))
  have hright : 2 ^ 39984 * 2 ^ 78 = (2 ^ 40062 : ℕ) := by
    simpa using Nat.pow_add (2 : ℕ) 39984 78
  exact hleft.trans (hmid.trans_eq hright)

theorem prime_denominator_floor (a : ℤ) (b : ℕ) (hb : 0 < b)
    (hS : (∑' n, primeDyadicTerm n) = a / b) :
    2 ^ 40062 ≤ b ∧ 10 ^ 12059 < b := by
  obtain ⟨hv, hvp, hdet, hlo, hhi⟩ := arithmetic
  have h := denominator_bound X c A u v up vp (by decide) endpoint
    hv hvp hdet hlo hhi a b hb hS
  have hbit := bit_floor.trans h
  exact ⟨hbit, lt_of_lt_of_le decimal_floor hbit⟩

theorem gap_denominator_floor (a : ℤ) (b : ℕ) (hb : 0 < b)
    (hS : (∑' n, primeGapDyadicTerm n) = a / b) :
    2 ^ 40062 ≤ b ∧ 10 ^ 12059 < b := by
  apply prime_denominator_floor (a + 2 * (b : ℤ)) b hb
  rw [tsum_primeDyadicTerm_eq_two_add_primeGap_unconditional, hS]
  push_cast
  have hbR : (b : ℝ) ≠ 0 := by exact_mod_cast hb.ne'
  field_simp [hbR]
  <;> ring

theorem denominator_floor_both (a : ℤ) (b : ℕ) (hb : 0 < b)
    (hS : (∑' n, primeDyadicTerm n) = a / b ∨
      (∑' n, primeGapDyadicTerm n) = a / b) :
    2 ^ 40062 ≤ b ∧ 10 ^ 12059 < b := by
  rcases hS with hp | hg
  · exact prime_denominator_floor a b hb hp
  · exact gap_denominator_floor a b hb hg

/-- The retained weaker binary floor is still available from the new route. -/
theorem printed_floor (a : ℤ) (b : ℕ) (hb : 0 < b)
    (hS : (∑' n, primeDyadicTerm n) = a / b ∨
      (∑' n, primeGapDyadicTerm n) = a / b) :
    2 ^ 39997 ≤ b ∧ 10 ^ 12040 < b := by
  obtain ⟨hbit, hdec⟩ := denominator_floor_both a b hb hS
  constructor
  · exact (Nat.pow_le_pow_right (by decide : (2 : ℕ) > 0)
        (by decide : 39997 ≤ 40062)).trans hbit
  · exact lt_trans (Nat.pow_lt_pow_right (by decide : (1 : ℕ) < 10)
        (by decide : 12040 < 12059)) hdec

end ErdosProblems.Erdos251.PaperV5.LargeStreaming
