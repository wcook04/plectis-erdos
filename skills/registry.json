    "catalog_projection": "skills/README.md",
    "write_command": "python3 scripts/agent_skill_catalog.py",
    "check_command": "python3 scripts/agent_skill_catalog.py --check",
    "dogfood_rule": "A route is not healthy merely because its files exist. Replay observed tasks, require the intended primary lane, and preserve the failing journey as a regression fixture."
