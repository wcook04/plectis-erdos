/-! ## 1. The unconditional band `t ≤ 72` -/

/-- **The certified band closes `t ≤ 72`, unconditionally.**  Every scale from `1` to `72`
carries a diagonal kill certificate at the universal period `H t`.  The band is unbroken:
`t ≤ 66` from `Discharge1G097`, `t = 67, …, 70` from the `t = 67` cell and its plateau,
`t = 71, 72` from the `t = 71` cell and `pl72`. -/
theorem exists_diagonalKill_le_72 (t : ℕ) (ht : t ≤ 72) :
    ∃ L, certifiedKill (periodLcm t) (periodLcm t) L :=
  Lift.exists_diagonalKill_le_72_of_band_le_70 Lift.exists_diagonalKill_le_70 t ht

/-- The band below `73` with the depth exhibited: at `67 … 70` the depth is `100`, at
`71, 72` it is `105`. -/
theorem diagonalKill_band_le_72_explicit (t : ℕ) (ht : t ≤ 72) :
    (t ≤ 66 ∧ ∃ L, certifiedKill (periodLcm t) (periodLcm t) L) ∨
    (67 ≤ t ∧ t ≤ 70 ∧ certifiedKill (periodLcm t) (periodLcm t) 100) ∨
    (71 ≤ t ∧ t ≤ 72 ∧ certifiedKill (periodLcm t) (periodLcm t) 105) := by
  rcases Nat.lt_or_ge t 67 with h | h
  · exact Or.inl ⟨by omega, DemandLedger.Discharge1G097.exists_diagonalKill_le_66 t (by omega)⟩
  · interval_cases t
    · exact Or.inr (Or.inl ⟨by omega, by omega, Lift.certifiedKill_diagonal_t67⟩)
    · exact Or.inr (Or.inl ⟨by omega, by omega, by
        rw [Lift.pl68]; exact Lift.certifiedKill_diagonal_t67⟩)
    · exact Or.inr (Or.inl ⟨by omega, by omega, by
        rw [Lift.pl69, Lift.pl68]; exact Lift.certifiedKill_diagonal_t67⟩)
    · exact Or.inr (Or.inl ⟨by omega, by omega, by
        rw [Lift.pl70, Lift.pl69, Lift.pl68]; exact Lift.certifiedKill_diagonal_t67⟩)
    · exact Or.inr (Or.inr ⟨by omega, by omega, Lift.certifiedKill_diagonal_t71⟩)
    · exact Or.inr (Or.inr ⟨by omega, by omega, by
        rw [Lift.pl72]; exact Lift.certifiedKill_diagonal_t71⟩)

/-! ## 2. The three new rungs: values and depth floors

Nothing in this subsection needs a factorisation.  The certificate inequality
`4 * H < 2 ^ L` (`Lift.certifiedKill_four_mul_lt`) is an unconditional consequence of
`certifiedKill_depth_floor`, so the floor at each rung is pure arithmetic. -/

theorem periodLcm_73_value : periodLcm 73 = 410555180440430163438262940577600 := by decide

theorem periodLcm_79_value : periodLcm 79 = 32433859254793982911622772305630400 := by decide

/-- **Depth floor at the `t = 73` rung.**  `4 * H 73 > 2^110`, so no certificate of depth
below `111` exists at this cell, whatever the window contains. -/
theorem t73_depth_floor {L : ℕ} (h : certifiedKill (periodLcm 73) (periodLcm 73) L) :
    111 ≤ L := by
  rcases Nat.lt_or_ge L 111 with hlt | hge
  swap
  · exact hge
  exfalso
  have h4 := Lift.certifiedKill_four_mul_lt h
  rw [periodLcm_73_value] at h4
  have hle : (2 : ℕ) ^ L ≤ 2 ^ 110 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbad : (4 * 410555180440430163438262940577600 : ℕ) < 2 ^ 110 := lt_of_lt_of_le h4 hle
  norm_num at hbad

/-- **Depth floor at the `t = 79` rung.**  `4 * H 79 > 2^116`, so no certificate of depth
below `117` exists at this cell. -/
theorem t79_depth_floor {L : ℕ} (h : certifiedKill (periodLcm 79) (periodLcm 79) L) :
    117 ≤ L := by
  rcases Nat.lt_or_ge L 117 with hlt | hge
  swap
  · exact hge
  exfalso
  have h4 := Lift.certifiedKill_four_mul_lt h
  rw [periodLcm_79_value] at h4
  have hle : (2 : ℕ) ^ L ≤ 2 ^ 116 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbad : (4 * 32433859254793982911622772305630400 : ℕ) < 2 ^ 116 := lt_of_lt_of_le h4 hle
  norm_num at hbad

/-- **Sharp negative at `t = 73`.**  The depth `105` that certifies `t = 71` — and which is
*exactly* minimal there — certifies nothing at `t = 73`. -/
theorem t73_not_certifiedKill_at_t71_depth :
    ¬ certifiedKill (periodLcm 73) (periodLcm 73) 105 := fun h => by
  have := t73_depth_floor h; omega

/-- **Sharp negative at `t = 79`.**  Every depth below `117` is dead at `t = 79`; in
particular the depth `113` that is exactly minimal at `t = 73`. -/
theorem t79_not_certifiedKill_below_117 {L : ℕ} (hL : L < 117) :
    ¬ certifiedKill (periodLcm 79) (periodLcm 79) L := fun h => by
  have := t79_depth_floor h; omega

/-! ## 3. Primality leaves for the two windows -/

theorem natCast_zmod_eq_one_iff_ladder (a m : ℕ) :
    (a : ZMod m) = 1 ↔ a % m = 1 % m := by
  simpa using ZMod.natCast_eq_natCast_iff' a 1 m

theorem natCast_zmod_ne_one_iff_ladder (a m : ℕ) :
    (a : ZMod m) ≠ 1 ↔ a % m ≠ 1 % m :=
  not_congr (natCast_zmod_eq_one_iff_ladder a m)

