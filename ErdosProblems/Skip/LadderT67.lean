/-- The least certified depth at `t = 81` is exactly `120`. -/
theorem t81_minimal_depth :
    certifiedKill (periodLcm 81) (periodLcm 81) 120 ∧
      ∀ L : ℕ, L < 120 → ¬ certifiedKill (periodLcm 81) (periodLcm 81) L := by
  refine ⟨certifiedKill_diagonal_t81, fun L hL hc => ?_⟩
  have h119 := t81_depth_floor hc
  interval_cases L
  · exact not_certifiedKill_diagonal_t81_119 hc

theorem pl82 : periodLcm 82 = periodLcm 81 :=
  DemandLedger.Discharge1G097.periodLcm_plateau_of_coprime_factors (a := 2) (b := 41) (s := 81)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)

/-- **The certified band closes `t ≤ 82`, unconditionally.**  Every scale from `1` to `82`
carries a diagonal kill certificate, with no holes: `t ≤ 66` from the corpus, `67 … 70` from
`Recon67`, `71, 72` from `CertT67`, `73 … 78`, `79, 80` and `81, 82` from the three
certificates proved here together with their plateaus.  The next jump is the prime `83`. -/
theorem exists_diagonalKill_le_82 (t : ℕ) (ht : t ≤ 82) :
    ∃ L, certifiedKill (periodLcm t) (periodLcm t) L := by
  rcases Nat.lt_or_ge t 81 with h | h
  · exact exists_diagonalKill_le_80 t (by omega)
  · interval_cases t
    · exact ⟨120, certifiedKill_diagonal_t81⟩
    · exact ⟨120, by rw [pl82]; exact certifiedKill_diagonal_t81⟩

/-- The band is closed downwards, so every initial segment of the lcm ray below `82` is
covered. -/
theorem diagonalKill_band_monotone {s t : ℕ} (hst : s ≤ t) (ht : t ≤ 82) :
    ∃ L, certifiedKill (periodLcm s) (periodLcm s) L :=
  exists_diagonalKill_le_82 s (le_trans hst ht)

/-- **The wall at `83`.**  `83` is prime, so `H 83 = 83 * H 82 ≠ H 82` and no plateau
transfer can carry a certificate past `82`: the band `t ≤ 82` is exactly maximal for
plateau transfer. -/
theorem periodLcm_83_eq_mul : periodLcm 83 = 83 * periodLcm 82 := by decide

theorem periodLcm_83_ne_82 : periodLcm 83 ≠ periodLcm 82 := by decide

theorem band_maximal_at_82 :
    (∀ t : ℕ, t ≤ 82 → ∃ L, certifiedKill (periodLcm t) (periodLcm t) L) ∧
      periodLcm 83 ≠ periodLcm 82 :=
  ⟨exists_diagonalKill_le_82, periodLcm_83_ne_82⟩

/-- **Depth floor at the next uncertified rung `t = 83`.**  `4 * H 83 > 2^124`, so any
future certificate there needs depth at least `125`. -/
theorem periodLcm_83_value : periodLcm 83 = 8076030954443701744994070304101969600 := by decide

theorem t83_depth_floor {L : ℕ} (h : certifiedKill (periodLcm 83) (periodLcm 83) L) :
    125 ≤ L := by
  rcases Nat.lt_or_ge L 125 with hlt | hge
  swap
  · exact hge
  exfalso
  have h4 := Lift.certifiedKill_four_mul_lt h
  rw [periodLcm_83_value] at h4
  have hle : (2 : ℕ) ^ L ≤ 2 ^ 124 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbad : (4 * 8076030954443701744994070304101969600 : ℕ) < 2 ^ 124 := lt_of_lt_of_le h4 hle
  norm_num at hbad

/-! ## 8. What the five-rung sample measures -/

/-- **The excess over the arithmetic floor is neither eventually zero nor monotone.**
`t = 71` fires exactly at its floor `105`; `t = 73` has floor `111` and fires only at `113`;
`t = 79` has floor `117` and fires only at `120`; `t = 81` has floor `119` and fires at
`120`.  The excesses read `2, 0, 2, 3, 1` at `t = 67, 71, 73, 79, 81`: the sample contains
strict decreases and strict increases, so neither "the floor is eventually attained" nor
"the excess is monotone" survives. -/
theorem ladder_excess_not_monotone :
    certifiedKill (periodLcm 71) (periodLcm 71) 105 ∧
      ¬ certifiedKill (periodLcm 73) (periodLcm 73) 112 ∧
      certifiedKill (periodLcm 73) (periodLcm 73) 113 ∧
      ¬ certifiedKill (periodLcm 79) (periodLcm 79) 119 ∧
      certifiedKill (periodLcm 79) (periodLcm 79) 120 ∧
      ¬ certifiedKill (periodLcm 81) (periodLcm 81) 119 ∧
      certifiedKill (periodLcm 81) (periodLcm 81) 120 :=
  ⟨Lift.certifiedKill_diagonal_t71, not_certifiedKill_diagonal_t73_112,
    certifiedKill_diagonal_t73, not_certifiedKill_diagonal_t79_119,
    certifiedKill_diagonal_t79, not_certifiedKill_diagonal_t81_119,
    certifiedKill_diagonal_t81⟩

/-- **Sharp negative: minimal certificate depth is not strictly increasing along the rung
ladder.**  `H 81 = 3 * H 80 = 3 * H 79`, so the modulus triples between the two cells, and
the arithmetic floor does rise, from `117` to `119`.  Yet the *least certified depth* is
`120` at both `t = 79` and `t = 81`.  A depth law of the form "each prime-power rung costs
at least one extra bit of certified depth" is therefore false. -/
theorem rung_depth_not_strictly_increasing :
    periodLcm 81 = 3 * periodLcm 79 ∧
      (certifiedKill (periodLcm 79) (periodLcm 79) 120 ∧
        ∀ L : ℕ, L < 120 → ¬ certifiedKill (periodLcm 79) (periodLcm 79) L) ∧
      (certifiedKill (periodLcm 81) (periodLcm 81) 120 ∧
        ∀ L : ℕ, L < 120 → ¬ certifiedKill (periodLcm 81) (periodLcm 81) L) :=
  ⟨by decide, t79_minimal_depth, t81_minimal_depth⟩

