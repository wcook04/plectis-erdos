/-! ## 1. The rung depth law, specialised at `t = 71`

`certifiedKill_four_mul_lt71` is the same elementary extraction that
`Recon67.certifiedKill_four_mul_lt` performs; it is restated here so that this
module stands alone on `Discharge1_G097` and does not have to be rebuilt when
`Recon67` is edited. -/

/-- Every diagonal certificate at scale `H` forces its modulus past `4*H`: the
forbidden zone has radius `2H + L + 2` and both excluded arcs must fit. -/
theorem certifiedKill_four_mul_lt71 {H L : ℕ} (h : certifiedKill H H L) :
    4 * H < 2 ^ L := by
  have hz := certifiedKill_depth_floor h
  have h4 : ((4 * H : ℕ) : ℤ) < ((2 ^ L : ℕ) : ℤ) := by push_cast; push_cast at hz; linarith
  exact_mod_cast h4

theorem periodLcm_71_value : periodLcm 71 = 5624043567677125526551547131200 := by decide

/-- **Depth floor at the `t = 71` rung.**  No certificate of depth below `105`
exists at this cell, whatever the window contains. -/
theorem t71_depth_floor {L : ℕ} (h : certifiedKill (periodLcm 71) (periodLcm 71) L) :
    105 ≤ L := by
  rcases Nat.lt_or_ge L 105 with hlt | hge
  swap
  · exact hge
  exfalso
  have h4 := certifiedKill_four_mul_lt71 h
  rw [periodLcm_71_value] at h4
  have hle : (2 : ℕ) ^ L ≤ 2 ^ 104 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbad : (4 * 5624043567677125526551547131200 : ℕ) < 2 ^ 104 := lt_of_lt_of_le h4 hle
  norm_num at hbad

/-- **Sharp negative.**  The depth that certifies `t = 67` is dead at `t = 71`:
the rung costs at least seven more bits. -/
theorem t71_not_certifiedKill_at_t67_depth :
    ¬ certifiedKill (periodLcm 71) (periodLcm 71) 100 := fun h => by
  have := t71_depth_floor h; omega

/-! ## 2. Primality leaves for the `t = 71` window -/

theorem natCast_zmod_eq_one_iff71 (a m : ℕ) :
    (a : ZMod m) = 1 ↔ a % m = 1 % m := by
  simpa using ZMod.natCast_eq_natCast_iff' a 1 m

theorem natCast_zmod_ne_one_iff71 (a m : ℕ) :
    (a : ZMod m) ≠ 1 ↔ a % m ≠ 1 % m :=
  not_congr (natCast_zmod_eq_one_iff71 a m)

