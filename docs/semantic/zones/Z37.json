  "concepts": [
    {
      "id": "mobius_mersenne_power_ladder",
      "label": "Möbius–Mersenne power ladder",
      "description": "The real sequence Θ_r = sum_{d>=1} μ(d)/(2^d-1)^r, viewed across the exponent r rather than along the original summation index."
    },
    {
      "id": "signed_mersenne_atom",
      "label": "Signed Mersenne atom",
      "description": "The dth ladder atom μ(d)/(2^d-1)^r; its Möbius sign prevents positive-measure moment arguments but its absolute value has a uniform geometric majorant."
    },
    {
      "id": "two_atom_dominant_part",
      "label": "Two-atom dominant part",
      "description": "The exact d=1,2 truncation 1-3^{-r}, whose shifted order-two Hankel gap is explicitly 4/3^{r+2}."
    },
    {
      "id": "geometric_tail_budget",
      "label": "Geometric tail budget",
      "description": "An explicit enclosure for the signed atoms after a finite prefix, obtained by comparison with powers of 2^{-r}."
    },
    {
      "id": "hankel_perturbation_budget",
      "label": "Hankel perturbation budget",
      "description": "The combined linear and quadratic tail-error allowance needed to transfer a positive two-atom Hankel gap to the full ladder."
    },
    {
      "id": "contraction_rate_separation",
      "label": "Contraction-rate separation",
      "description": "The tail-error budget contracts faster than 1/4 per rung while the dominant two-atom gap contracts exactly by 1/3."
    },
    {
      "id": "five_atom_low_rung_certificate",
      "label": "Five-atom low-rung certificate",
      "description": "The exact d=1,...,5 prefix 1-3^{-r}-7^{-r}-31^{-r}, plus a geometric residual, used to verify the four rungs below the asymptotic induction threshold."
    },
    {
      "id": "order_two_signed_hankel_negativity",
      "label": "Order-two signed Hankel negativity",
      "description": "Strict negativity of every shifted 2x2 Hankel determinant Θ_r Θ_{r+2}-Θ_{r+1}^2 for r>=1."
    },
    {
      "id": "erdos249_totient_offset",
      "label": "Erdős #249 totient offset",
      "description": "The identity Θ_2 = sum_{n>=1} φ(n)2^{-n}-1/2, which locates the #249 constant inside the ladder without deciding its arithmetic nature."
    }
  ],
